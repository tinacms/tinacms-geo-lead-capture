{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/*.mjs": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/digest",
      "schedule": "0 6 * * 5"
    }
  ],
  "rewrites": [
    { "source": "/geo", "destination": "/" },
    { "source": "/geo/(.*)", "destination": "/$1" }
  ]
}
